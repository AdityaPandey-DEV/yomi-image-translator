# ========================================================
# Manga & Manhwa Image Translator — Environment Variables
# ========================================================

# --- Frontend Firebase Web Credentials (Vite) ---
# Get these from: Firebase Console -> Project Settings -> General -> Your apps (Web)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef..."

# --- Backend Firebase Admin SDK (Vercel Serverless Functions) ---
# Get these from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID="your-project-id"

# Minified one-line JSON string of the downloaded service account JSON:
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"}'

